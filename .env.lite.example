# =============================================================================
# VELOX LITE — minimum-cost paper trading configuration TEMPLATE.
# Target monthly burn: <$50/mo (Anthropic usage only).
# =============================================================================
# How this works:
#   VELOX_LITE=true is the master kill switch. It disables every paid/external
#   API regardless of whether keys are present below. Per-provider _ENABLED
#   flags let you re-enable one thing at a time when you fund it, without
#   flipping the master switch back on.
#
# Setup:
#   cp .env.lite.example .env
#   # fill in ALPACA_* and ANTHROPIC_API_KEY from your vault
# =============================================================================

# === Master switch ===
VELOX_LITE=true

# === Kept: Alpaca (broker + free market data) ===
ALPACA_API_KEY=<your-alpaca-key>
ALPACA_SECRET_KEY=<your-alpaca-secret>
ALPACA_PAPER=true

# === Kept: Anthropic (single-model jury) ===
ANTHROPIC_API_KEY=<your-anthropic-key>

# === Kept: free feeds (no per-call cost) ===
FRED_API_KEY=<free-from-fred-st-louis>
FINNHUB_API_KEY=<free-tier-from-finnhub>
STOCKTWITS_EMAIL=<your-stocktwits-email>
STOCKTWITS_PASSWORD=<your-stocktwits-password>

# === Disabled: paid APIs (kept commented for easy re-enable) ===
# X / Twitter — historical cost driver. Stays OFF until proven ROI.
X_BEARER_TOKEN=
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_API_ENABLED=false

# OpenAI — second vote in the jury. Off while proving Claude-only is sufficient.
OPENAI_API_KEY=
OPENAI_API_ENABLED=false

# xAI / Grok — third vote + grok_x_trending scanner. Off.
XAI_API_KEY=
XAI_API_ENABLED=false

# Perplexity — news sentiment. Off.
PERPLEXITY_API_KEY=
PERPLEXITY_API_ENABLED=false

# Polygon — $199/mo. Off until funded. Alpaca provides the replacement data.
POLYGON_API_KEY=
POLYGON_API_ENABLED=false

# Unusual Whales — $375/mo. Off.
UW_API_TOKEN=
UW_API_ENABLED=false

# === Trading parameters (conservative Lite defaults) ===
TOTAL_CAPITAL=25000
DEPLOYED_CAPITAL=10000
POSITION_SIZE_PCT=4.0
MAX_CONCURRENT_POSITIONS=8
MAX_DAILY_LOSS_PCT=2.0
MAX_POSITION_LOSS_PCT=2.0

# === Ratchet (profit factory) ===
PROFIT_RATCHET_HARD_STOP_PCT=-0.75
PROFIT_RATCHET_ACTIVATION_PCT=0.30
PROFIT_RATCHET_TRAIL_PCT=1.00
PROFIT_RATCHET_INITIAL_FLOOR_PCT=0.10
PROFIT_RATCHET_MIN_HOLD_SECONDS=120

# === Scanner — slower cadence since we've cut signal feeds ===
SCAN_INTERVAL_SECONDS=180
SCAN_INTERVAL_FAST_SECONDS=120
SCAN_INTERVAL_SLOW_SECONDS=300
SCAN_INTERVAL_OVERNIGHT_SECONDS=900

# === Consensus — single-model, lower cap ===
CONSENSUS_ENABLED=true
CONSENSUS_MAX_CALLS_PER_HOUR=30
CLAUDE_MAX_CALLS_PER_HOUR=60
MIN_JURY_CONFIDENCE=45

# === Options pilot — OFF in Lite (no UW flow signal) ===
OPTIONS_ENABLED=false
OPTIONS_PILOT_ENABLED=false

# === Dashboard ===
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8421
DASHBOARD_TOKEN=<your-dashboard-token>

# === Logging ===
LOG_LEVEL=INFO
